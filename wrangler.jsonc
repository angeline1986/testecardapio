{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testecardapio",
  "account_id": "7496391ddd3c860ed9431530397973d3",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "cardapio_events"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "SESSION_SECRET"]
  }
}
